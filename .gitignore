# ============================================================
# Track only what is needed to run; ignore generated / downloaded / secret files
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# ---- secrets / local environment ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---- logs / run outputs ----
*.log
fault-inject.log.jsonl
results/
test_results/
harbor_results/
jobs/
runs/
pipe/runs/

# ---- generated test task copies (derived from data/) ----
pipe/tasks/
pipe/configs/test-*.yaml

# ---- downloaded benchmark data (re-fetch: bash data/download.sh) ----
data/terminal-bench-2-1/
data/nl2repo/
data/*.tar.gz

# ---- generated deliverables / experiment record (not tracked) ----
exp/
pipe/all-injections.html

# ---- root source material (slides / diagram, not tracked) ----
/*.pptx
/*.jpg

# ---- OS ----
.DS_Store
